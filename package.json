{
  "name": "wallpapers",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.14.1",
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run wallpapers:sync && astro dev",
    "build": "bun run wallpapers:sync && astro build",
    "prepare": "husky",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "wallpapers:check": "bun scripts/sync-wallpapers.ts --check",
    "wallpapers:sync": "bun scripts/sync-wallpapers.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "bun run wallpapers:check && bun run type-check && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
