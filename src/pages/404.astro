---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not Found | Wallpapers" description="The requested wallpaper page could not be found.">
  <section class="page-shell page-shell--narrow" aria-labelledby="page-title">
    <header class="page-header">
      <p class="eyebrow">404</p>
      <h1 id="page-title">Not Found</h1>
      <p class="page-description">The requested page could not be found.</p>
    </header>

    <a class="text-link" href={import.meta.env.BASE_URL}>Wallpapers</a>
  </section>
</Layout>
