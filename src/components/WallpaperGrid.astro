---
import type { CollectionEntry } from "astro:content";
import WallpaperCard from "./WallpaperCard.astro";

interface Props {
  wallpapers: CollectionEntry<"wallpapers">[];
}

const { wallpapers } = Astro.props;
---

{
  wallpapers.length > 0 ? (
    <ul class="wallpaper-grid" aria-label="Wallpapers">
      {wallpapers.map((wallpaper, index) => (
        <li>
          <WallpaperCard wallpaper={wallpaper} index={index} />
        </li>
      ))}
    </ul>
  ) : (
    <section class="empty-state" aria-label="No wallpapers">
      <p>No wallpapers yet.</p>
    </section>
  )
}

