---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";

interface Props {
  wallpaper: CollectionEntry<"wallpapers">;
  index: number;
}

const { wallpaper, index } = Astro.props;
const { data } = wallpaper;

const baseUrl = import.meta.env.BASE_URL;
const fileUrl = `${baseUrl}files/${encodeURIComponent(data.fileName)}`;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/wallpapers/*.{jpg,jpeg,png,webp,avif}"
);
const imageKey = `/src/assets/wallpapers/${data.fileName}`;
---

<article class="wallpaper-card">
  <a class="wallpaper-preview-link" href={fileUrl} aria-label={`Open ${data.title}`}>
    {
      images[imageKey] ? (
        <Picture
          src={images[imageKey]()}
          formats={["avif", "webp"]}
          widths={[400, 800, 1200]}
          sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw"
          alt={data.title}
          loading={index < 4 ? "eager" : "lazy"}
          fetchpriority={index < 4 ? "high" : "auto"}
        />
      ) : (
        <img
          class="wallpaper-preview"
          src={fileUrl}
          alt={data.title}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>

  <div class="wallpaper-meta">
    <h2>{data.title}</h2>
    <p class="wallpaper-resolution">{data.width} &times; {data.height}</p>
    {data.creator ? <p>{data.creator}</p> : null}
  </div>

  <div class="wallpaper-actions">
    <a href={fileUrl}>Open</a>
    <a href={fileUrl} download={data.fileName}>Download</a>
  </div>
</article>

